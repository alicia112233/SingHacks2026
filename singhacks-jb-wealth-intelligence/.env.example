# Use the pooled Postgres connection string supplied by your Vercel Marketplace
# database integration. Never commit the actual value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional independent LLM judges. External evaluation is disabled unless the
# explicit opt-in is true. Vercel OIDC can authenticate in hosted environments;
# AI_GATEWAY_API_KEY is the alternative for local or non-Vercel environments.
TESSERA_EXTERNAL_JUDGES_ENABLED=false
# Comma-separated AI Gateway model IDs (maximum 3). Replace any entry with a
# current model ID, for example anthropic/claude-opus-4.6.
TESSERA_JUDGE_MODELS=openai/gpt-5.4,anthropic/claude-sonnet-4.6,google/gemini-3.7-flash
AI_GATEWAY_API_KEY=

# Optional evidence-chat generation. Without this opt-in, the assistant remains
# available using local source-grounded extractive answers.
TESSERA_CHAT_ENABLED=false
TESSERA_CHAT_MODEL=openai/gpt-5.4

# Optional Chroma Cloud semantic evidence retrieval. Create a database and a
# database-scoped API key at https://trychroma.com, then set the values from the
# dashboard's Connect panel. Keep retrieval disabled until the corpus is indexed.
TESSERA_RETRIEVAL_ENABLED=true
TESSERA_EMBEDDING_MODEL=openai/text-embedding-3-small
CHROMA_COLLECTION=tessera-knowledge-v1
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=dev

# Optional live market-news refresh. Google News RSS is used by default.
# Only deterministic, exposure-relevant headlines are admitted as events.
TESSERA_LIVE_NEWS_ENABLED=false
TESSERA_NEWS_INTERVAL_SECONDS=21600
# Optional comma-separated RSS URLs overriding the default feeds.
TESSERA_NEWS_FEEDS=